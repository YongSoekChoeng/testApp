/* logs-mapper.xml id="selectActionLogList" 액션 로그 리스트 조회  */
		 
		SELECT AA.*
		  FROM (SELECT COUNT(*) OVER() AS total
					 , A.*
			      FROM (
	 
		 
			/* logs-mapper.xml id="selectActionLogListSql" 액션 로그 리스트 조회 쿼리 */
			SELECT tb1.mb_id                     /* 회사코드 VARCHAR(20)*/
				 , tb1.emp_cd                    /* 행위자 사번 VARCHAR(40)*/
				 , tb2.emp_nm
				 , tb1.action_type               /* 행위 유형 VARCHAR(20)*/
				 , tb4.cd_vl_nm AS action_type_nm
				 , tb1.action_url                /* 호출 URL VARCHAR(200)*/
				 , tb1.action_query_string       /* URL에 전달된 파라미터 값 VARCHAR(1000)*/
				 , tb1.action_ip                 /* 행위자 IP VARCHAR(100)*/
				 , DATE_FORMAT(tb1.in_dtm, '%Y-%m-%d %H:%i:%s') AS in_dtm                    /* 입력 시간 DATETIME*/
			  FROM tbsy_action_log tb1
   LEFT OUTER JOIN tbin_empmst tb2
   				ON tb1.mb_id = tb2.mb_id
   			   AND tb1.emp_cd = tb2.emp_cd
   LEFT OUTER JOIN (SELECT * FROM tbcm_common_code WHERE mb_id = 'PRD' AND grp_cmm_cd = 'ACTION_TYPE') tb4
   				ON tb1.mb_id = tb4.mb_id
   			   AND tb1.action_type = tb4.cd_vl
   			 WHERE tb1.mb_id = 'PRD'
   			   AND tb1.emp_cd NOT IN ('SADMIN')
   			   AND DATE_FORMAT(tb1.in_dtm, '%Y-%m-%d') BETWEEN IFNULL('2026-09-01', '1900-01-01') AND IFNULL('2026-09-30', '2099-12-31')
			  
	 
		 
			           ) A
				 
					 ORDER BY seq desc
				 
			   ) AA
		
		 
		 
		 LIMIT 20 OFFSET 0 
