		<!-- 원본은 springfox-swagger2를 통해 이 애노테이션을 받았으나, swagger UI/API 문서화 모듈 자체는
		     이 테스트 프로젝트 범위에서 제외했다. VO에 남아있는 @ApiModelProperty만 컴파일되도록
		     애노테이션 정의만 가벼운 이 의존성으로 대체한다. -->
		<dependency>
		    <groupId>io.swagger</groupId>
		    <artifactId>swagger-annotations</artifactId>
		    <version>1.5.20</version>
		</dependency>

		<!-- 원본은 jasypt-spring31(EncryptablePropertyPlaceholderConfigurer)을 썼지만, 이 테스트 프로젝트는
		     평문 로컬 설정을 쓰므로 그 통합 모듈은 뺐다. 다만 CommUtil의 범용 암복호화 유틸 메서드가
		     jasypt 코어의 StandardPBEStringEncryptor를 직접 쓰고 있어 코어 라이브러리만 남긴다. -->
		<dependency>
		    <groupId>org.jasypt</groupId>
		    <artifactId>jasypt</artifactId>
